# Lumoras Growth (apps/seo): runtime settings.
# Local: copy to apps/seo/.env.local. VPS3: /opt/lumoras/env/lumoras-seo.env (the owner creates it).
# Never commit real values.

# --- Database (PostgreSQL 16, database "seo"; see deploy/postgres/10-seo-database.sh) ---
# On VPS3 the host is lumoras-postgres:5432 and the passwords are SEO_APP_DB_PASSWORD and
# SEO_DB_PASSWORD from /opt/lumoras/env/postgres.env.
# App role: what the web server and the worker connect as. Not a superuser, cannot
# bypass row-level security, owns no tables.
DATABASE_URL=postgres://seo_app:change-me@localhost:5432/seo
# Owner role: used ONLY by scripts/migrate.ts (runs on web container start).
# Must be a different role from DATABASE_URL; the runner refuses otherwise.
# On VPS3 the role is named after the database, as for the other projects (01-databases.sh).
DATABASE_URL_OWNER=postgres://seo:change-me@localhost:5432/seo

# --- Server ---
# Port for `next start` (the image sets 3007; 3000, 3002, 3005 and 3006 are taken on VPS3).
PORT=3007
# debug | info | warn | error (JSON lines on stdout). Default info.
LOG_LEVEL=info

# --- Auth (Better Auth 1.7.7) ---
# Public origin of the app, no path. Cookies are Secure whenever this is https.
# Production must use https (plain http only for localhost / 127.0.0.1).
# Development default: http://localhost:3007. Host name pending owner decision #1.
BETTER_AUTH_URL=https://growth.lumoras.ai
# Signs session cookies and encrypts OAuth tokens. 32+ random characters:
#   openssl rand -base64 32
# Required in production; development uses a fixed throwaway value when unset.
BETTER_AUTH_SECRET=
# Google sign-in (OAuth client, redirect URI <BETTER_AUTH_URL>/api/auth/callback/google).
# Leave BOTH empty to turn Google sign-in off: the button shows, disabled, with the reason.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend, as apps/web/lib/email.ts) ---
# Sign-in links, invitations, runway alerts and review requests (Phase 3: the worker sends
# runway alerts too, so it needs these as well). Required in production. In development,
# when unset, the message is printed in the log instead of being sent (alerts are still
# shown in the app).
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. growth@lumoras.ai
EMAIL_FROM=
# Display name of the sender. Default "Lumoras Growth".
EMAIL_FROM_NAME=

# --- Encryption of stored credentials (AES-256-GCM, lib/crypto/secrets.ts) ---
# Versioned keys: every version still needed to decrypt, comma-separated, each 32 random
# bytes base64 (openssl rand -base64 32). New secrets use ENCRYPTION_KEY_CURRENT
# (default: the highest version). To rotate: add version n+1, set CURRENT to it, deploy,
# re-encrypt (rotateConnectionKeys), then drop the old version.
ENCRYPTION_KEYS=1:replace-with-32-random-bytes-base64
ENCRYPTION_KEY_CURRENT=1
# Or a single key (version 1). Set ENCRYPTION_KEYS or ENCRYPTION_KEY, not both.
# ENCRYPTION_KEY=

# --- Design system route ---
# /design is on in development and 404s in production builds unless this is 1
# (for a review deploy). Leave unset in production.
ENABLE_DESIGN_ROUTE=

# --- Worker ---
# How often the idle worker logs a heartbeat, in ms (min 1000). Default 300000 (5 min).
WORKER_HEARTBEAT_MS=
# How many pipeline runs one worker executes at once (1 to 16). Default 2.
WORKER_CONCURRENCY=

# --- Tests only (never set these on a server) ---
# A THROWAWAY server's admin URL (needs CREATEDB and CREATEROLE). Integration tests and the
# e2e web server create and drop their own databases and roles there.
# Unset: integration tests are skipped and e2e refuses to start.
TEST_DATABASE_URL=
# Port for the Playwright web server (default 3107).
E2E_PORT=
# Use an already-installed Chromium for Playwright instead of downloading one.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Where e2e saves screenshots (seo-p1-*.png … seo-p3-*.png). Unset: no screenshots.
SCREENSHOT_DIR=
# The next four are set by e2e/serve.ts; each refuses to load next to an https BETTER_AUTH_URL.
# Write outgoing email as JSON files to this directory instead of sending it.
EMAIL_OUTBOX_DIR=
# Let the crawler reach local fake sites: comma-separated host.test=http://127.0.0.1:PORT
CRAWLER_TEST_ORIGINS=
# Multiply every rate limit (the suite signs in many times from one IP). Default 1.
RATE_LIMIT_SCALE=
# RLS isolation test only: break a guard on purpose to see the suite fail
# (bypassrls | policy:<table> | noforce:<table>). See docs/phase-1-summary.md.
RLS_TEST_SABOTAGE=
# Port the fake client site listens on in e2e (default: any free port).
FAKE_SITE_PORT=
# Pipeline suite only: write the generated lumoras.ai article and its fake pull request here
# (for the lumoras.ai typecheck + build check in a worktree). See docs/phase-3-summary.md.
ACCEPTANCE_OUT=
# FakeLlm only: wait this many ms per model turn, so a run is slow enough to watch live
# (e2e sets 450). Ignored by the real provider. Default 0.
FAKE_LLM_LATENCY_MS=

# --- SEO data provider (Phase 2; owner decision #3, docs/provider-decision.md) ---
# Which provider answers research: none | fake | openseo | dataforseo.
# Default: fake in development and tests (synthetic fixtures, no network, no real money),
# none in production (paid research off until a real provider is set). fake is refused next
# to an https BETTER_AUTH_URL. Every call is priced, budgeted, cached and logged either way.
#
# PRODUCTION (owner decision #3, changed 10 October 2026): DataForSEO directly, on Lumoras's own
# DataForSEO account (no reseller margin, no third-party terms on client work):
#   SEO_PROVIDER=dataforseo
#   DATAFORSEO_LOGIN=...            (app.dataforseo.com → API Access: the API login, not the email)
#   DATAFORSEO_PASSWORD=...         (the API password shown there, not the account password)
# Try it first against DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com (free dummy data).
# OpenSEO (hosted or self-hosted) stays supported below but is no longer the production choice.
SEO_PROVIDER=
# dataforseo: our own DataForSEO API login and password (app.dataforseo.com → API Access).
# Server-side only; never sent to a browser, a log line or a model.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: https://sandbox.dataforseo.com (free dummy data) instead of https://api.dataforseo.com.
# Nothing else is accepted (a loopback origin only in tests).
DATAFORSEO_BASE_URL=
# openseo: hosted (the owner's openseo.so account) or selfhosted (our own instance). Default selfhosted.
OPENSEO_MODE=
# hosted: the account's personal API key (starts with oseo_), sent only as "Authorization: Bearer"
# from the server to OpenSEO; never to a browser, a log line or a model. Required in hosted mode.
OPENSEO_API_KEY=
# The MCP endpoint. hosted: default https://app.openseo.so/mcp (https only). selfhosted: the
# instance's endpoint (OPENSEO_MCP_URL below is the older name and still works).
OPENSEO_URL=
# Optional: the OpenSEO project research runs in when a site has none of its own (Site settings →
# SEO data provider). Unset: a project per site domain is found with list_projects or created.
OPENSEO_PROJECT_ID=
# selfhosted: the instance's MCP endpoint, e.g. http://open-seo:3001/mcp on the private
# lumoras_internal network. Docker self-hosting has NO auth on /mcp: never route it through Caddy.
OPENSEO_MCP_URL=
# selfhosted, optional: a bearer token sent to the instance (a proxy's token in front of it).
OPENSEO_MCP_TOKEN=
# Optional Cloudflare Access service token, for an OpenSEO instance behind Cloudflare Access. Set both or neither.
OPENSEO_CF_ACCESS_CLIENT_ID=
OPENSEO_CF_ACCESS_CLIENT_SECRET=

# --- Google Search Console and GA4 (Phase 2) ---
# OAuth client (Google Cloud console → Credentials → OAuth client ID → Web application) with the
# redirect URI <BETTER_AUTH_URL>/api/google/callback and read-only scopes webmasters.readonly and
# analytics.readonly (enable the Search Console API, Google Analytics Admin API and Data API).
# It may be the same client as Google sign-in, with this second redirect URI added.
# Leave BOTH empty: the Connect buttons show a designed "not configured" state.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Tests only (set by e2e/serve.ts): every Google OAuth and API endpoint lives at this loopback
# origin (a local fake Google). Refused next to an https BETTER_AUTH_URL.
# Development: `pnpm --filter seo fakes` runs a fake Google at http://127.0.0.1:4573; set this
# and the fake client id/secret it prints, and `pnpm --filter seo seed` connects and syncs sonorch.ai.
GOOGLE_API_TEST_ORIGIN=

# --- Measurement (Phase 4) ---
# Worker (and `pnpm --filter seo gsc:sync`): minimum milliseconds between two Google API requests
# for one Search Console / GA4 property. Default 200 (5 a second, well under Search Console's
# 1,200 a minute per site). URL Inspection is paced separately at 1 a second and capped per site
# per day in site settings. 0 only for tests against the local fake.
GOOGLE_PACE_MS=
# Paid measurement (rank checks, site audits, backlinks) uses SEO_PROVIDER above, priced first and
# charged to each workspace's seo_credits budget; with SEO_PROVIDER=none it is skipped and the
# screens say so. Cadences are per-site settings (Site → Settings → Measurement), not env.

# --- Writing model (Phase 3) ---
# Which model writes: none | fake | anthropic.
# Default: fake in development and tests (FakeLlm: recorded fixtures, no network, no real money),
# none in production (writing stays off, and runs say why, until the owner sets anthropic).
# fake is refused next to an https BETTER_AUTH_URL. Model usage is charged to the workspace's
# llm_tokens budget through the ledger either way, refused below the reserve.
LLM_PROVIDER=
# anthropic: the Anthropic API key (console.anthropic.com → API keys). Server-side only:
# read by the worker; never sent to a browser, a log line or a model.
ANTHROPIC_API_KEY=
# Optional: an https proxy in front of the Anthropic API (e.g. a gateway). Default: the SDK's.
ANTHROPIC_BASE_URL=
# Model ids. DRAFT writes briefs and drafts; REVIEW chooses topics and fact-checks (section 3).
LLM_MODEL_DRAFT=claude-sonnet-5-5
LLM_MODEL_REVIEW=claude-opus-5-5
# Optional price table override, USD per million tokens, merged over the defaults in lib/llm/prices.ts:
#   {"claude-sonnet-5-5": {"input": 2, "output": 10, "cacheRead": 0.2, "cacheWrite": 2.5}}
# A model missing from the table is priced at the most expensive entry (never under-charged).
LLM_PRICES_JSON=

# --- Outbound fetching (Phase 3: fact-check sources, external link checks, live checks) ---
# live: pages are fetched through the SSRF guard; recorded: answers come from recorded pages
# only (lib/llm/fixtures.ts). Default: recorded in development and tests, live in production.
# recorded is refused next to an https BETTER_AUTH_URL.
OUTBOUND_FETCH=
# Tests and the dev fakes only: comma-separated *.test host names the SSRF guard resolves to
# 127.0.0.1 (the fake GitHub, Gitea and webhook receivers), e.g. github.test,webhook.test.
# Refused next to an https BETTER_AUTH_URL. With github.test here, `pnpm --filter seo seed` points
# lumoras.ai's Git connection at the fake GitHub; without it, at the real timtasay/lumoras.ai with
# no token ("token needed": the owner pastes a fine-grained token on the Connections tab).
OUTBOUND_TEST_HOSTS=
