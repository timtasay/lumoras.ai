# lumoras.ai: runtime settings. On VPS3 these live in /opt/lumoras/env/lumoras-web.env.

# Resend: send-only API key and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=notification@mail.sonorch.ai
EMAIL_FROM_NAME=Lumoras

# Where /api/demo sends each request. Defaults to info@lumoras.ai.
DEMO_REQUEST_EMAIL=info@lumoras.ai
